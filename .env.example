# =============================================================================
# MERLIN (Airdale) Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------

# Anthropic API key for Claude inference (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs API key for text-to-speech (required for voice)
ELEVENLABS_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# Claude Settings
# -----------------------------------------------------------------------------

# Claude model to use for inference
CLAUDE_MODEL=claude-sonnet-4-20250514

# Max tokens for Claude responses (keeps comms tactical)
CLAUDE_MAX_TOKENS=1024

# Max tokens for briefings, checklists, and flight plans
CLAUDE_MAX_TOKENS_BRIEFING=2048

# Max message pairs to retain in conversation history
CLAUDE_MAX_HISTORY=20

# Temperature for Claude responses (0.0-1.0, lower = more deterministic)
CLAUDE_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# SimConnect Bridge
# -----------------------------------------------------------------------------

# WebSocket host for the SimConnect bridge
# NOTE: If running in WSL2, set this to your Windows host IP (e.g., 172.x.x.x),
# not "localhost". Find it with: powershell.exe -c "ipconfig" | grep IPv4
SIMCONNECT_WS_HOST=localhost

# WebSocket port for the SimConnect bridge
SIMCONNECT_WS_PORT=8080

# Full WebSocket URL (constructed from host+port if empty)
# SIMCONNECT_BRIDGE_URL=ws://localhost:8080

# -----------------------------------------------------------------------------
# Voice Pipeline -- Speech-to-Text (faster-whisper)
# -----------------------------------------------------------------------------

# faster-whisper model: tiny, base, small, medium, large-v3-turbo, large-v3
# large-v3-turbo recommended for best accuracy with aviation terminology.
WHISPER_MODEL=large-v3-turbo

# URL of the local faster-whisper HTTP service (OpenAI-compatible API)
# The Docker service maps external port 9090 to internal port 8000.
# WHISPER_URL=http://localhost:9090

# -----------------------------------------------------------------------------
# Voice Pipeline -- Text-to-Speech (ElevenLabs)
# -----------------------------------------------------------------------------

# ElevenLabs voice ID for MERLIN's voice
ELEVENLABS_VOICE_ID=

# ElevenLabs model ID
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# ChromaDB (Context Store)
# -----------------------------------------------------------------------------

# URL of the ChromaDB HTTP server (Docker)
# CHROMADB_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Screen Capture (Optional)
# -----------------------------------------------------------------------------

# Enable screen capture for Claude Vision
SCREEN_CAPTURE_ENABLED=false

# Frames per second for screen capture
SCREEN_CAPTURE_FPS=1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Local Inference (RIO) -- LLM Backend
# -----------------------------------------------------------------------------

# LLM backend: "anthropic" for Claude API, "local" for vLLM/local models
LLM_BACKEND=anthropic

# Base URL for local OpenAI-compatible LLM API (vLLM)
# Only used when LLM_BACKEND=local
LLM_API_URL=http://localhost:8081/v1

# Local model name (must match the model directory in ./models/llm/)
LLM_MODEL_LOCAL=qwen3.5-35b-a3b-aviation

# -----------------------------------------------------------------------------
# Local Inference (RIO) -- TTS Backend
# -----------------------------------------------------------------------------

# TTS backend: "elevenlabs" for cloud API, "local" for Kokoro/local TTS
TTS_BACKEND=elevenlabs

# Base URL for local TTS service
# Only used when TTS_BACKEND=local
TTS_LOCAL_URL=http://localhost:9091

# Voice ID for local Kokoro TTS engine
# Available voices: af_heart, af_alloy, am_adam, am_michael, bf_emma, bm_george
TTS_VOICE_ID_LOCAL=af_heart
