# =============================================================================
# MERLIN (Airdale) Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------

# Anthropic API key for Claude inference (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs API key for text-to-speech (required for voice)
ELEVENLABS_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# Claude Settings
# -----------------------------------------------------------------------------

# Claude model to use for inference
CLAUDE_MODEL=claude-sonnet-4-20250514

# Max tokens for Claude responses (keeps comms tactical)
CLAUDE_MAX_TOKENS=1024

# Max tokens for briefings, checklists, and flight plans
CLAUDE_MAX_TOKENS_BRIEFING=2048

# Max message pairs to retain in conversation history
CLAUDE_MAX_HISTORY=20

# Temperature for Claude responses (0.0-1.0, lower = more deterministic)
CLAUDE_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Telemetry Service
# -----------------------------------------------------------------------------

# Telemetry service host (the universal telemetry hub)
TELEMETRY_SERVICE_HOST=localhost

# Telemetry service consumer port
TELEMETRY_SERVICE_PORT=8080

# Full telemetry service WebSocket URL (constructed from host+port if empty)
# TELEMETRY_SERVICE_URL=ws://localhost:8080/ws/telemetry

# Legacy SimConnect bridge settings (deprecated -- use telemetry service)
# SIMCONNECT_WS_HOST=localhost
# SIMCONNECT_WS_PORT=8080
# SIMCONNECT_BRIDGE_URL=ws://localhost:8080

# -----------------------------------------------------------------------------
# Voice Pipeline -- Speech-to-Text (faster-whisper)
# -----------------------------------------------------------------------------

# faster-whisper model: tiny, base, small, medium, large-v3 (medium recommended)
# This is passed to the faster-whisper-server container as WHISPER__MODEL.
WHISPER_MODEL=medium

# URL of the local faster-whisper HTTP service (OpenAI-compatible API)
# The Docker service maps external port 9090 to internal port 8000.
# WHISPER_URL=http://localhost:9090

# -----------------------------------------------------------------------------
# Voice Pipeline -- Text-to-Speech (ElevenLabs)
# -----------------------------------------------------------------------------

# ElevenLabs voice ID for MERLIN's voice
ELEVENLABS_VOICE_ID=

# ElevenLabs model ID
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# ChromaDB (Context Store)
# -----------------------------------------------------------------------------

# URL of the ChromaDB HTTP server (Docker)
# CHROMADB_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Screen Capture (Optional)
# -----------------------------------------------------------------------------

# Enable screen capture for Claude Vision
SCREEN_CAPTURE_ENABLED=false

# Frames per second for screen capture
SCREEN_CAPTURE_FPS=1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
