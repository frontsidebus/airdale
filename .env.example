# =============================================================================
# MERLIN v2 — Environment Configuration
# =============================================================================
#
# SETUP:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your API keys below
#   3. Start MERLIN:    ./scripts/start.sh
#
# Your .env file is git-ignored and will never be committed.
# See docs/CONFIGURATION.md for detailed descriptions of every setting.
#
# =============================================================================


# =============================================================================
# REQUIRED — You must set these before MERLIN will start
# =============================================================================

# Anthropic API key (powers Claude, the brain)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Deepgram API key (powers streaming speech-to-text)
# Get one at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Cartesia API key (powers ultra-low-latency text-to-speech)
# Get one at: https://play.cartesia.ai/
CARTESIA_API_KEY=


# =============================================================================
# VOICE PIPELINE — Speech-to-Text
# =============================================================================

# STT backend: 'deepgram' (cloud streaming, recommended) or 'whisper' (local)
STT_BACKEND=deepgram

# Deepgram model — nova-3 has the best aviation vocabulary recognition
DEEPGRAM_MODEL=nova-3

# Silence threshold before Deepgram considers the speaker done (milliseconds)
# Lower = faster response, higher = fewer false endpoints
DEEPGRAM_ENDPOINTING_MS=300

# --- Legacy Whisper fallback (only used when STT_BACKEND=whisper) ---
# Requires the Whisper Docker container to be running
# WHISPER_MODEL=large-v3-turbo
# WHISPER_URL=http://localhost:9090


# =============================================================================
# VOICE PIPELINE — Turn Detection (deciding when you have finished speaking)
# =============================================================================

# End-of-turn detector: 'smart' (semantic, Smart Turn v3 ONNX) or 'silence'
# (fixed silence threshold). 'smart' falls back to 'silence' automatically at
# startup if onnxruntime or the model file is missing — run
# `python3 tools/fetch_turn_model.py` to enable it.
TURN_DETECTOR=smart

# Probability above which the semantic detector calls the turn complete.
# Raise it to make MERLIN more willing to wait through a pause — aviation
# phraseology is full of them ("descend and maintain... one zero thousand").
TURN_THRESHOLD=0.5

# Silence observed before consulting the semantic detector (milliseconds).
# Lower than VAD_SILENCE_MS because the model decides on content, not duration.
TURN_PROBE_SILENCE_MS=150

# Silence threshold for the fixed-silence detector and the RMS fallback (ms)
VAD_SILENCE_MS=400


# =============================================================================
# VOICE PIPELINE — Text-to-Speech
# =============================================================================

# TTS backend: 'cartesia' (fastest), 'elevenlabs' (best voice quality), 'local' (free/offline)
TTS_BACKEND=cartesia

# --- Cartesia (primary, ~90ms time-to-first-byte) ---
# Browse voices at https://play.cartesia.ai/
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-2

# --- ElevenLabs fallback (only used when TTS_BACKEND=elevenlabs) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- ElevenLabs voice tuning (optional, only for ElevenLabs backend) ---
# TTS_STABILITY=0.75
# TTS_SIMILARITY_BOOST=0.80
# TTS_STYLE=0.15

# --- Local Kokoro fallback (only used when TTS_BACKEND=local) ---
# Free, offline, no API key needed. Lower quality than cloud options.
# TTS_LOCAL_URL=http://localhost:8880
# TTS_VOICE_ID_LOCAL=af_heart


# =============================================================================
# CLAUDE (LLM) — Model & Response Tuning
# =============================================================================

# Primary model for complex reasoning (Sonnet recommended)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Fast model for short acknowledgments (Haiku, used by model routing)
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Default temperature (overridden dynamically by flight phase)
# Critical phases (takeoff/landing): 0.1 | Normal: 0.3 | Cruise/preflight: 0.5
CLAUDE_TEMPERATURE=0.3

# Max tokens per response (keeps cockpit comms tactical)
CLAUDE_MAX_TOKENS=1024

# Max tokens for briefings, checklists, and flight plans
CLAUDE_MAX_TOKENS_BRIEFING=2048

# Conversation history depth (message pairs retained before summarization)
CLAUDE_MAX_HISTORY=20

# --- Dynamic temperature tiers (optional, these are the defaults) ---
# CLAUDE_TEMP_CRITICAL=0.1
# CLAUDE_TEMP_NORMAL=0.3
# CLAUDE_TEMP_RELAXED=0.5

# --- Rolling conversation summary (optional) ---
# CLAUDE_SUMMARY_INTERVAL=10
# CLAUDE_SUMMARY_MAX_TOKENS=256


# =============================================================================
# TELEMETRY SERVICE — Sim Adapter Connection
# =============================================================================

# The telemetry service hub that adapters push to and consumers subscribe from
TELEMETRY_SERVICE_HOST=localhost
TELEMETRY_SERVICE_PORT=8080

# Full WebSocket URL (auto-constructed from host+port if empty)
# TELEMETRY_SERVICE_URL=ws://localhost:8080/ws/telemetry

# --- WSL2 users ---
# If running the orchestrator in WSL2 and the MSFS adapter on Windows:
# TELEMETRY_SERVICE_HOST=host.docker.internal   # Docker
# TELEMETRY_SERVICE_HOST=$(hostname).local       # WSL2 native


# =============================================================================
# AUTHORITY & SAFETY — Whether MERLIN May Touch the Aircraft
# =============================================================================

# How far MERLIN may go with the aircraft:
#   advisory — never commands; reports what it would have done
#   assisted — executes, but withholds anything flagged 'warning' by command_safety
#   full     — executes unless command_safety blocks it outright
# Defaults to 'full' because that is exactly the pre-authority behaviour, so
# upgrading changes nothing and restriction is opt-in.
# CAVEAT: 'assisted' keys off 'warning' severity, and only 7 safety rules exist
# (gear, flaps, autopilot, throttle) — for the other 16 of 20 commandable
# systems 'assisted' behaves identically to 'full'. See docs/CONFIGURATION.md.
AUTHORITY_LEVEL=full

# Seconds after MERLIN issues a command during which a change to that command's
# own telemetry fields is credited to MERLIN. Without it, MERLIN's own command
# reads back as a pilot override and it drops its own authority.
AUTHORITY_OVERRIDE_GRACE_S=30.0

# Seconds to wait before re-scrutinising the fields of a command that has no
# verification rule. Surfaces, autopilot and radios broadcast at 1 Hz, so a
# shorter settle reads the pre-command value.
AUTHORITY_OVERRIDE_SETTLE_S=2.0

# Seconds MERLIN stays advisory after a pilot override. Rolling — each new
# override pushes the expiry out. Authority restores automatically when it lapses.
AUTHORITY_OVERRIDE_COOLDOWN_S=120.0

# Consecutive command-path timeouts before MERLIN latches to advisory. The latch
# is cleared on reconnect, never by a later success.
AUTHORITY_WATCHDOG_MAX_TIMEOUTS=3

# Seconds to wait for a command acknowledgment from the sim adapter
AUTHORITY_COMMAND_TIMEOUT_S=5.0

# Seconds spent polling telemetry to confirm a command actually took effect
AUTHORITY_VERIFY_TIMEOUT_S=3.0

# Outer deadline on the set_aircraft_control tool call. MUST be greater than
# AUTHORITY_COMMAND_TIMEOUT_S + AUTHORITY_VERIFY_TIMEOUT_S, or the tool deadline
# pre-empts the ack timeout and the watchdog never sees it. Checked at startup.
AUTHORITY_TOOL_TIMEOUT_S=12.0


# =============================================================================
# CHROMADB — RAG Vector Store
# =============================================================================

# ChromaDB runs as a Docker container for document retrieval
# CHROMADB_URL=http://localhost:8000


# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Screen capture for Claude Vision analysis (experimental)
SCREEN_CAPTURE_ENABLED=false
# SCREEN_CAPTURE_FPS=1

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
