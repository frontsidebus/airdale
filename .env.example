# =============================================================================
# MERLIN (Airdale) Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------

# Anthropic API key for Claude inference (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs API key for text-to-speech (fallback TTS, optional in v2)
ELEVENLABS_API_KEY=your-key-here

# Deepgram API key for streaming speech-to-text (v2 primary STT)
DEEPGRAM_API_KEY=your-key-here

# Cartesia API key for ultra-low-latency TTS (v2 primary TTS)
CARTESIA_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# Claude Settings
# -----------------------------------------------------------------------------

# Claude model to use for inference
CLAUDE_MODEL=claude-sonnet-4-20250514

# Max tokens for Claude responses (keeps comms tactical)
CLAUDE_MAX_TOKENS=1024

# Max tokens for briefings, checklists, and flight plans
CLAUDE_MAX_TOKENS_BRIEFING=2048

# Max message pairs to retain in conversation history
CLAUDE_MAX_HISTORY=20

# Default temperature for Claude responses (overridden by dynamic phase logic in v2)
CLAUDE_TEMPERATURE=0.3

# Fast model for short queries (v2 model routing)
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# Telemetry Service
# -----------------------------------------------------------------------------

# Telemetry service host (the universal telemetry hub)
TELEMETRY_SERVICE_HOST=localhost

# Telemetry service consumer port
TELEMETRY_SERVICE_PORT=8080

# Full telemetry service WebSocket URL (constructed from host+port if empty)
# TELEMETRY_SERVICE_URL=ws://localhost:8080/ws/telemetry

# -----------------------------------------------------------------------------
# Voice Pipeline -- Speech-to-Text
# -----------------------------------------------------------------------------

# STT backend: 'deepgram' (cloud streaming, v2 default) or 'whisper' (local batch, legacy)
STT_BACKEND=deepgram

# Deepgram model (nova-3 recommended for aviation)
DEEPGRAM_MODEL=nova-3

# Deepgram endpointing silence threshold in ms
DEEPGRAM_ENDPOINTING_MS=300

# --- Whisper (legacy fallback) ---
# faster-whisper model: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# WHISPER_URL=http://localhost:9090

# -----------------------------------------------------------------------------
# Voice Pipeline -- Text-to-Speech
# -----------------------------------------------------------------------------

# TTS backend: 'cartesia' (low-latency, v2 default), 'elevenlabs' (cloud), 'local' (Kokoro)
TTS_BACKEND=cartesia

# --- Cartesia (v2 primary) ---
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-2

# --- ElevenLabs (fallback) ---
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# URL of the local Kokoro TTS server (only used when TTS_BACKEND=local)
TTS_LOCAL_URL=http://localhost:8880

# Voice ID for local Kokoro TTS (only used when TTS_BACKEND=local)
TTS_VOICE_ID_LOCAL=af_heart

# ElevenLabs voice stability (0.0-1.0, higher = more consistent)
TTS_STABILITY=0.75

# ElevenLabs similarity boost (0.0-1.0, higher = closer to original voice)
TTS_SIMILARITY_BOOST=0.80

# ElevenLabs style (0.0-1.0, V2+ models only, higher = more expressive)
TTS_STYLE=0.15

# -----------------------------------------------------------------------------
# ChromaDB (Context Store)
# -----------------------------------------------------------------------------

# URL of the ChromaDB HTTP server (Docker)
# CHROMADB_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Screen Capture (Optional)
# -----------------------------------------------------------------------------

# Enable screen capture for Claude Vision
SCREEN_CAPTURE_ENABLED=false

# Frames per second for screen capture
SCREEN_CAPTURE_FPS=1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
